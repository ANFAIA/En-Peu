    print(f"Mejorado Test R²: {r2_test:.4f}")
    print(f"Incremento: +{(r2_test - 0.9169):.4f}")

# Meta alcanzada
if r2_test >= 0.97:
    print("¡OBJETIVO ALCANZADO! R² >= 0.97")
else:
    print(f"Progreso hacia R² 0.97: {(r2_test/0.97)*100:.1f}%")

# Guardar resultados en Drive (opcional)
